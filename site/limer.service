[Unit]
Description=Limer HTTP server and load balancer
Documentation=https://github.com/limer-sh/limer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/limer validate -c /etc/limer/Limerfile
ExecStart=/usr/local/bin/limer run -c /etc/limer/Limerfile
ExecReload=/usr/local/bin/limer reload
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
