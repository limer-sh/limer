# Limerfile - example configuration for Limer.
#
# The syntax follows Caddyfile conventions: one directive per line,
# blocks open with "{" at the end of a line and close with "}" on its
# own line, "#" starts a comment, values with spaces are quoted and
# {$ENV} is replaced from the environment.

# Global options (optional, must be the first block)
{
    workers auto              # worker processes (default 1)
    admin 127.0.0.1:2019      # admin API: /health /upstreams /metrics /config /reload
                              #   POST /upstreams/<host:port>/drain|undrain|weight/<n>, /overrides
    log_level info            # debug | info | warn | error
    max_connections auto      # per worker; auto = half the descriptor limit
    pidfile /tmp/limer.pid    # enables `limer reload` and `limer stop`
    grace 10s                 # how long to drain connections on shutdown
    email {$ACME_EMAIL:admin@example.com}   # ACME account contact for automatic HTTPS
    storage /var/lib/limer    # certificates and ACME state
    acme_challenge http-01    # or tls-alpn-01 (port 443 only) or dns-01 (wildcards):
    # acme_dns_script /etc/limer/dns-hook.sh   # called: present|cleanup <domain> <txt>
    # acme_dns_propagation 30s
}

# Snippets can be imported anywhere; {args.N} are substituted.
(security) {
    header X-Frame-Options DENY
    header X-Content-Type-Options nosniff
    header -Server
}

# --- A public site: automatic HTTPS, HTTP/2, redirect from http -----------
# (hostnames imply https; the certificate comes from Let's Encrypt over
# http-01, so port 80 must reach this process and DNS must point here)

example.com, www.example.com {
    import security
    encode zstd br gzip
    log {
        output stdout             # or: output file /var/log/limer/example.com.log
        format json
    }

    # Static assets straight from disk
    handle_path /static/* {
        root /srv
        file_server
    }

    # --- Payload-based routing ------------------------------------------
    # Routes are tried in order; the first whose matchers all pass wins.

    route orders {
        match method POST
        match path /api/*
        match json type == order refund          # value lists are OR'ed
        reverse_proxy 10.0.1.10:8080 10.0.1.11:8080 {
            lb_policy hash json customer.id      # same customer -> same upstream
            health_uri /healthz
        }
    }

    route big-spenders {
        match json order.total >= 1000
        reverse_proxy 10.0.2.10:8080
    }

    route forms {
        match form action == checkout
        reverse_proxy 10.0.3.10:8080 10.0.3.11:8080 {
            lb_policy hash form cart_id
        }
    }

    route tenant {
        match header X-Tenant acme globex
        reverse_proxy 10.0.5.10:8080 10.0.5.11:8080 {
            lb_policy hash header X-Tenant
        }
    }

    route login {
        match path /login
        rate_limit login {            # token bucket per client ip
            key {remote_ip}
            rate 5r/m
            burst 5
        }
        reverse_proxy 10.0.0.10:8080 10.0.0.11:8080 {
            lb_policy sticky_cookie session   # same browser -> same upstream
        }
    }

    route admin {
        match path /admin/*
        match remote_ip 10.0.0.0/8 192.168.0.0/16
        basic_auth {
            # generate with: htpasswd -nbB ops secret
            ops $2y$05$l9pjdv3mAmpT3Nb4DJQGs.sqLQ0ebYbbH6oWYp0HCQFPp8wA.K9Da
        }
        uri strip_prefix /admin
        reverse_proxy 10.0.6.10:8080
    }

    route legacy {
        match path /v1/*
        redir https://api.example.com{uri} 308
    }

    # --- Default pool ----------------------------------------------------
    reverse_proxy 10.0.0.10:8080 10.0.0.11:8080 10.0.0.12:8080 weight=2 {
        lb_policy least_conn          # round_robin | least_conn | random | first | ip_hash | uri_hash | hash <source> [name]
        lb_retries 2                  # try other upstreams when one fails
        max_fails 3                   # passive health: failures before an upstream is ejected
        fail_timeout 10s              #   ... and for how long
        unhealthy_status 5xx          # count 5xx responses as failures
        health_uri /healthz           # active health check
        health_interval 10s
        connect_timeout 5s
        response_timeout 60s
        header_up X-Real-IP {remote_ip}
        header_down +Via "1.1 limer"
    }
}

# --- An https upstream, with verification ---------------------------------
api.example.com {
    reverse_proxy https://10.0.7.10:8443 {
        tls_server_name backend.internal   # name to verify (system CA store, or tls_trusted_ca_certs <pem>)
    }
}

# --- gRPC: HTTP/2 to the upstreams, trailers pass through ------------------
grpc.example.com {
    reverse_proxy h2c://10.0.8.10:50051 h2c://10.0.8.11:50051   # h2:// for TLS upstreams
}

# --- Local development: self-signed certificate, no ACME -------------------
localhost {
    root /srv
    file_server browse
    route {
        match path /api/*
        reverse_proxy 127.0.0.1:3000
    }
}

# --- Plain http on a port, any host ---------------------------------------
:8080 {
    reverse_proxy 127.0.0.1:9001 127.0.0.1:9002 {
        lb_policy hash json tenant
    }
}
